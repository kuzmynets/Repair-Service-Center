@model List<Repair_Service_Center.Models.ViewModels.UserRoleViewModel>
@{
    ViewData["Title"] = "Users and roles";
    var roles = AppRoles.All;
}

<h1>Users and roles</h1>
<p class="text-muted">A new user gets the role Customer. Here the administrator can make a user a moderator or an administrator.</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Full name</th>
            <th>E-mail</th>
            <th>Phone</th>
            <th>Requests</th>
            <th>Role</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            // List of roles with the current role of the user selected
            var roleList = new SelectList(roles, user.Role);
            <tr>
                <td>@user.FullName @if (user.IsCurrentUser) { <span class="badge bg-secondary ms-1">you</span> }</td>
                <td>@user.Email</td>
                <td class="text-nowrap">@user.PhoneNumber</td>
                <td>@user.OrdersCount</td>
                <td>
                    @if (user.IsCurrentUser)
                    {
                        <span class="badge bg-brand">@user.Role</span>
                    }
                    else
                    {
                        <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@user.Id"/>
                            <select name="role" class="form-select form-select-sm w-auto" asp-items="roleList"></select>
                            <button type="submit" class="btn btn-sm btn-brand">Save</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
