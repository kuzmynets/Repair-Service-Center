@model IEnumerable<Technician>
@{
    ViewData["Title"] = Localizer["About us"];
}

<div class="row align-items-center g-4 g-lg-5 mb-5">
    <div class="col-lg-6">
        <h1 class="mb-3">@Localizer["About us"]</h1>
        <p class="lead">@Localizer["Repair Service Center is a workshop for repair of phones, computers and home appliances."]</p>
        <p class="text-muted">
            @Localizer["We make the repair process clear for the customer: the prices are published on the site, the request can be sent online, and every repair gets a warranty. For non-standard problems our technician makes diagnostics first and then tells you the price."]
        </p>
    </div>
    <div class="col-lg-6">
        <img src="~/images/workshop.svg" alt="@Localizer["Workshop of the service center"]" class="img-fluid rounded-4"/>
    </div>
</div>

<h2 class="section-title">@Localizer["Why customers choose us"]</h2>
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="feature-box">
            <h5>@Localizer["Clear prices"]</h5>
            <p class="text-muted small mb-0">@Localizer["The price and the time of every service are in the price list before you order."]</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-box">
            <h5>@Localizer["Warranty"]</h5>
            <p class="text-muted small mb-0">@Localizer["We give a warranty for the work and for the new parts."]</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-box">
            <h5>@Localizer["Online requests"]</h5>
            <p class="text-muted small mb-0">@Localizer["Send a request from the site and follow its status."]</p>
        </div>
    </div>
</div>

<h2 class="section-title">@Localizer["Our technicians"]</h2>
<div class="row g-4 mb-5">
    @foreach (var technician in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 text-center p-3">
                <div class="avatar mx-auto mb-3">@technician.FullName.Substring(0, 1)</div>
                <h5 class="mb-1">@technician.FullName</h5>
                <p class="text-muted small mb-1">@technician.Specialization</p>
                <p class="small mb-0">@(Localizer["<b>{0}</b> years of experience", technician.ExperienceYears])</p>
            </div>
        </div>
    }
</div>

<h2 class="section-title">@Localizer["Contacts"]</h2>
<div class="row g-4">
    <div class="col-md-6">
        <table class="table">
            <tbody>
            <tr><th>@Localizer["Address"]</th><td>@Localizer["Khmelnytskyi, Ukraine (demo address)"]</td></tr>
            <tr><th>@Localizer["Phone"]</th><td>@Localizer["+380 00 000 00 00 (demo)"]</td></tr>
            <tr><th>@Localizer["Working hours"]</th><td>@Localizer["Mon–Fri 9:00–19:00, Sat 10:00–16:00"]</td></tr>
            </tbody>
        </table>
    </div>
    <div class="col-md-6 d-flex align-items-center">
        <a asp-controller="RepairRequest" asp-action="Create" class="btn btn-accent btn-lg">@Localizer["Request a repair"]</a>
    </div>
</div>
