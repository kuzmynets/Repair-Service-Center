@{
    ViewData["Title"] = "Home Page";
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">Repair Service Center</h1>
    <p class="lead">Repair of smartphones, laptops and home appliances. Choose a service from the price list or describe your problem.</p>
    <a asp-controller="PriceListItems" asp-action="Index" class="btn btn-primary btn-lg me-2">Price List</a>
    <a asp-controller="Orders" asp-action="Create" class="btn btn-outline-primary btn-lg">New Order</a>
</div>

<div class="row text-center g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">@ViewData["ServicesCount"]</h2>
                <p class="card-text">services in the price list</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">@ViewData["TechniciansCount"]</h2>
                <p class="card-text">technicians</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">@ViewData["ActiveOrdersCount"]</h2>
                <p class="card-text">orders in work</p>
            </div>
        </div>
    </div>
</div>
