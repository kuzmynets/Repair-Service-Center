@model StudentInfo
@{
    ViewData["Title"] = Localizer["Author"];
}

<div class="text-center">
    <h1 class="display-5 mb-4">@Localizer["Information about student"]</h1>

    <table class="table table-bordered w-auto mx-auto text-start">
        <tr><th>@Localizer["Full name"]</th><td>@Model.FullName</td></tr>
        <tr><th>@Localizer["Group"]</th><td>@Model.Group</td></tr>
        <tr><th>@Localizer["University"]</th><td>@Model.University</td></tr>
        <tr><th>@Localizer["Project topic"]</th><td>@Model.ProjectTopic</td></tr>
    </table>
</div>
