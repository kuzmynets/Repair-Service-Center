@model Repair_Service_Center.Models.Slot

@{
    ViewData["Title"] = Localizer["Delete Time Slot"];
}

<h1>@SharedLocalizer["Delete"]</h1>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

<h3>@SharedLocalizer["Are you sure you want to delete this?"]</h3>
<div>
    <h4>@Localizer["Time slot"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TechnicianId)</dt>
        <dd class="col-sm-9">@Model.Technician?.FullName</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StartTime)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.StartTime)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EndTime)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.EndTime)</dd>
        <dt class="col-sm-3">@Localizer["Status"]</dt>
        <dd class="col-sm-9">@(Model.IsBooked ? SharedLocalizer["Booked"] : SharedLocalizer["Free"])</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">@SharedLocalizer["Delete"]</button>
        <a asp-action="Index" class="btn btn-link">@SharedLocalizer["Back to list"]</a>
    </form>
</div>
