@model IEnumerable<Repair_Service_Center.Models.Slot>

@{
    ViewData["Title"] = Localizer["Time slots"];
    var showPast = ViewData["ShowPast"] is true;
    var technicians = (SelectList)ViewData["TechnicianFilter"]!;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">@Localizer["Time slots"]</h1>
    <div class="d-flex gap-2">
        <form asp-action="Generate" method="post">
            <button type="submit" class="btn btn-outline-brand">@Localizer["Fill next 7 days"]</button>
        </form>
        <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Create new"]</a>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-sm-5 col-md-4">
        <label class="form-label small" for="technicianId">@Localizer["Technician"]</label>
        <select id="technicianId" name="technicianId" class="form-select" asp-items="technicians">
            <option value="">@Localizer["All technicians"]</option>
        </select>
    </div>
    <div class="col-auto">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="showPast" name="showPast" value="true" checked="@showPast"/>
            <label class="form-check-label" for="showPast">@Localizer["Show past slots"]</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-brand">@Localizer["Apply"]</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Localizer["Date"]</th>
            <th>@Localizer["Time"]</th>
            <th>@Html.DisplayNameFor(model => model.TechnicianId)</th>
            <th>@Localizer["Status"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.StartTime.ToString("ddd dd.MM.yyyy")</td>
            <td>@item.StartTime.ToString("HH:mm")&ndash;@item.EndTime.ToString("HH:mm")</td>
            <td>@item.Technician?.FullName</td>
            <td>
                @if (item.IsBooked)
                {
                    <span class="badge bg-primary">@SharedLocalizer["Booked"]</span>
                }
                else
                {
                    <span class="badge bg-success">@SharedLocalizer["Free"]</span>
                }
            </td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Edit"]</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Details"]</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@SharedLocalizer["Delete"]</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">@Localizer["No time slots. Press «Fill next 7 days» to create the schedule."]</p>
}
