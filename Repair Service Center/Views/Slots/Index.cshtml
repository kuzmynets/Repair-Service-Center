@model IEnumerable<Repair_Service_Center.Models.Slot>

@{
    ViewData["Title"] = "Time slots";
    var showPast = ViewData["ShowPast"] is true;
    var technicians = (SelectList)ViewData["TechnicianFilter"]!;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Time slots</h1>
    <div class="d-flex gap-2">
        <form asp-action="Generate" method="post">
            <button type="submit" class="btn btn-outline-brand">Fill next 7 days</button>
        </form>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-sm-5 col-md-4">
        <label class="form-label small" for="technicianId">Technician</label>
        <select id="technicianId" name="technicianId" class="form-select" asp-items="technicians">
            <option value="">All technicians</option>
        </select>
    </div>
    <div class="col-auto">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="showPast" name="showPast" value="true" checked="@showPast"/>
            <label class="form-check-label" for="showPast">Show past slots</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-brand">Apply</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>@Html.DisplayNameFor(model => model.TechnicianId)</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.StartTime.ToString("ddd dd.MM.yyyy")</td>
            <td>@item.StartTime.ToString("HH:mm")&ndash;@item.EndTime.ToString("HH:mm")</td>
            <td>@item.Technician?.FullName</td>
            <td>
                @if (item.IsBooked)
                {
                    <span class="badge bg-primary">Booked</span>
                }
                else
                {
                    <span class="badge bg-success">Free</span>
                }
            </td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No time slots. Press "Fill next 7 days" to create the schedule.</p>
}
