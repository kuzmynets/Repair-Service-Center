@model Repair_Service_Center.Models.ComplexityLevel

@{
    ViewData["Title"] = Localizer["Edit Complexity Level"];
}

<h1>@SharedLocalizer["Edit"]</h1>

<h4>@Localizer["Complexity Level"]</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">@SharedLocalizer["Save"]</button>
                <a asp-action="Index" class="btn btn-link">@SharedLocalizer["Back to list"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
