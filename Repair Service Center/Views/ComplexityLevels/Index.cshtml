@model IEnumerable<Repair_Service_Center.Models.ComplexityLevel>

@{
    ViewData["Title"] = Localizer["Complexity Levels"];
}

<h1>@Localizer["Complexity Levels"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Create new"]</a>
</p>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Edit"]</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Details"]</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@SharedLocalizer["Delete"]</a>
            </td>
        </tr>
}
    </tbody>
</table>
