@model List<Order>
@{
    ViewData["Title"] = Localizer["My requests"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">@Localizer["My requests"]</h1>
    <a asp-controller="RepairRequest" asp-action="Create" class="btn btn-accent">@Localizer["New request"]</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(Localizer["You have no requests yet. Choose a service in the <a href='{0}'>catalog</a> or describe your problem in a new request.", Url.Action("Index", "Services")!])
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>@Localizer["No."]</th>
                <th>@Localizer["Created"]</th>
                <th>@Localizer["Device / service"]</th>
                <th>@Localizer["Time"]</th>
                <th>@Localizer["Status"]</th>
                <th>@Localizer["Price"]</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var order in Model)
            {
                var item = order.Items.FirstOrDefault();
                <tr>
                    <td>@order.Id</td>
                    <td class="text-nowrap">@order.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (item?.PriceListItem != null)
                        {
                            <span>@item.PriceListItem.DeviceType?.Name &ndash; @item.PriceListItem.RepairType?.Name</span>
                        }
                        else
                        {
                            <span class="text-muted">@Localizer["Custom request"]</span>
                        }
                        @if (!string.IsNullOrEmpty(order.DeviceBrand) || !string.IsNullOrEmpty(order.DeviceModel))
                        {
                            <div class="small text-muted">@order.DeviceBrand @order.DeviceModel</div>
                        }
                    </td>
                    <td class="text-nowrap">@(item?.Slot?.TimeText ?? "-")</td>
                    <td><span class="badge @UiHelper.StatusBadge(order.Status)">@SharedLocalizer[order.Status.GetDisplayName()]</span></td>
                    <td class="text-nowrap">@(order.TotalCost.HasValue ? SharedLocalizer.GetString("{0} UAH", order.TotalCost.Value.ToString("0")).Value : "-")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Details"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
