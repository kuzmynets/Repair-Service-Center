@model Repair_Service_Center.Models.Order

@{
    ViewData["Title"] = Localizer["Order Details"];
}

<h1>@SharedLocalizer["Details"]</h1>

<div>
    <h4>@Localizer["Order"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CustomerName)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CustomerName)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CustomerPhone)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CustomerPhone)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CustomerEmail)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CustomerEmail)
        </dd>
        <dt class="col-sm-3">@Localizer["Device"]</dt>
        <dd class="col-sm-9">
            @Model?.DeviceBrand @Model?.DeviceModel
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CustomerAddress)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CustomerAddress)
        </dd>
        <dt class="col-sm-3">@Localizer["Account"]</dt>
        <dd class="col-sm-9">
            @(Model?.User?.Email ?? Localizer.GetString("without account (created by the administrator or before registration)").Value)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CreatedAt)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-9">
            @if (Model != null) { @SharedLocalizer[Model.Status.GetDisplayName()] }
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ProblemDescription)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ProblemDescription)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TotalCost)
        </dt>
        <dd class="col-sm-9">
            @* Laboratory work 8: the number is formatted by [DisplayFormat], the currency is translated *@
            @if (Model?.TotalCost != null)
            {
                <text>@Html.DisplayFor(model => model.TotalCost) @SharedLocalizer["UAH"]</text>
            }
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TechnicianId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Technician!.FullName)
        </dd>
    </dl>
</div>

<h4 class="mt-4">@Localizer["Items"]</h4>
@if (Model!.Items.Any())
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>@Localizer["Service"]</th><th>@Localizer["Time slot"]</th><th>@Localizer["Duration"]</th><th class="text-end">@Localizer["Price"]</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    @if (item.PriceListItem != null)
                    {
                        @($"{item.PriceListItem.DeviceType?.Name} \u2013 {item.PriceListItem.RepairType?.Name} ({item.PriceListItem.ComplexityLevel?.Name})")
                    }
                    else
                    {
                        <span class="text-muted">@Localizer["custom work"]</span>
                    }
                </td>
                <td>
                    @if (item.Slot != null)
                    {
                        <a asp-controller="Slots" asp-action="Details" asp-route-id="@item.SlotId">@item.Slot.TimeText</a>
                    }
                </td>
                <td>@UiHelper.FormatDuration(item.DurationMinutes, SharedLocalizer)</td>
                <td class="text-end">@(SharedLocalizer["{0} UAH", item.Price.ToString("0.00")])</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">@Localizer["No items. This is a custom request: the administrator sets the price after diagnostics."]</p>
}

<h4 class="mt-4">@Localizer["Status history"]</h4>
<ul class="status-history">
    @foreach (var record in Model.StatusHistory.OrderBy(h => h.ChangedAt))
    {
        <li>
            <span class="badge @UiHelper.StatusBadge(record.Status)">@SharedLocalizer[record.Status.GetDisplayName()]</span>
            <span class="text-muted small ms-2">@record.ChangedAt.ToString("dd.MM.yyyy HH:mm")</span>
            @if (!string.IsNullOrEmpty(record.Comment))
            {
                <span class="small ms-2">@record.Comment</span>
            }
        </li>
    }
</ul>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-secondary">@SharedLocalizer["Edit"]</a>
    <a asp-action="Index" class="btn btn-link">@SharedLocalizer["Back to list"]</a>
</div>
