@model OrderSearchViewModel

@{
    ViewData["Title"] = Localizer["Orders"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">@Localizer["Orders"]</h1>
    <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Create new"]</a>
</div>

<!-- Search of orders by several criteria -->
<form asp-action="Index" method="get" class="card p-3 mb-3 search-panel">
    <div class="row g-2 align-items-end">
        <div class="col-lg-4">
            <label asp-for="SearchString" class="form-label small"></label>
            <input asp-for="SearchString" type="search" class="form-control"
                   placeholder="@Localizer["No., name, phone, email, brand or model"]"/>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="Status" class="form-label small"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<OrderStatus>()">
                <option value="">@Localizer["All statuses"]</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="TechnicianId" class="form-label small"></label>
            <select asp-for="TechnicianId" class="form-select" asp-items="Model.Technicians">
                <option value="">@Localizer["All technicians"]</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label asp-for="DateFrom" class="form-label small"></label>
            <input asp-for="DateFrom" class="form-control"/>
        </div>
        <div class="col-6 col-lg-2">
            <label asp-for="DateTo" class="form-label small"></label>
            <input asp-for="DateTo" class="form-control"/>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-brand">@SharedLocalizer["Search"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Reset"]</a>
            <span class="ms-auto align-self-center small text-muted">@(Localizer["Found: <b>{0}</b>", Model.Orders.Count])</span>
        </div>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Localizer["No."]</th>
            <th>@Html.DisplayNameFor(model => model.Orders[0].CreatedAt)</th>
            <th>@Html.DisplayNameFor(model => model.Orders[0].CustomerName)</th>
            <th>@Html.DisplayNameFor(model => model.Orders[0].CustomerPhone)</th>
            <th>@Localizer["Device"]</th>
            <th>@Html.DisplayNameFor(model => model.Orders[0].Status)</th>
            <th>@Html.DisplayNameFor(model => model.Orders[0].TotalCost)</th>
            <th>@Html.DisplayNameFor(model => model.Orders[0].TechnicianId)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Orders)
{
        <tr>
            <td>@item.Id</td>
            <td class="text-nowrap">@Html.DisplayFor(modelItem => item.CreatedAt)</td>
            <td>@Html.DisplayFor(modelItem => item.CustomerName)</td>
            <td class="text-nowrap">@Html.DisplayFor(modelItem => item.CustomerPhone)</td>
            <td>@item.DeviceBrand @item.DeviceModel</td>
            <td><span class="badge @UiHelper.StatusBadge(item.Status)">@SharedLocalizer[item.Status.GetDisplayName()]</span></td>
            <td class="text-nowrap">@if (item.TotalCost != null) { <text>@Html.DisplayFor(modelItem => item.TotalCost) @SharedLocalizer["UAH"]</text> }</td>
            <td>@item.Technician?.FullName</td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Edit"]</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Details"]</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@SharedLocalizer["Delete"]</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Orders.Any())
{
    <p class="text-muted">@Localizer["No orders match the search criteria."]</p>
}
