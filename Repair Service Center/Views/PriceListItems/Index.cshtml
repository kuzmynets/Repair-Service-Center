@model IEnumerable<Repair_Service_Center.Models.PriceListItem>

@{
    ViewData["Title"] = Localizer["Price List"];
}

<h1>@Localizer["Price List"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Create new"]</a>
</p>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.DeviceTypeId)</th>
            <th>@Html.DisplayNameFor(model => model.RepairTypeId)</th>
            <th>@Html.DisplayNameFor(model => model.ComplexityLevelId)</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.DurationMinutes)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.DeviceType!.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.RepairType!.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.ComplexityLevel!.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Price) @SharedLocalizer["UAH"]</td>
            <td>@Html.DisplayFor(modelItem => item.DurationMinutes)</td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Edit"]</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Details"]</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@SharedLocalizer["Delete"]</a>
            </td>
        </tr>
}
    </tbody>
</table>
