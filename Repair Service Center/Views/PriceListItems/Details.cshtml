@model Repair_Service_Center.Models.PriceListItem

@{
    ViewData["Title"] = "Price List Item Details";
}

<h1>Details</h1>

<div>
    <h4>Price List Item</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DeviceTypeId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DeviceType!.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.RepairTypeId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.RepairType!.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ComplexityLevelId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ComplexityLevel!.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DurationMinutes)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DurationMinutes)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>
