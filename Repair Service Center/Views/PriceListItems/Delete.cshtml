@model Repair_Service_Center.Models.PriceListItem

@{
    ViewData["Title"] = Localizer["Delete Price List Item"];
}

<h1>@SharedLocalizer["Delete"]</h1>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

<h3>@SharedLocalizer["Are you sure you want to delete this?"]</h3>
<div>
    <h4>@Localizer["Price List Item"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DeviceTypeId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DeviceType!.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.RepairTypeId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.RepairType!.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ComplexityLevelId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ComplexityLevel!.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Price) @SharedLocalizer["UAH"]
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DurationMinutes)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DurationMinutes)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">@SharedLocalizer["Delete"]</button>
        <a asp-action="Index" class="btn btn-link">@SharedLocalizer["Back to list"]</a>
    </form>
</div>
