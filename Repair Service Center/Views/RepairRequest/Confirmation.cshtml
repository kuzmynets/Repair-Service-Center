@model Order
@{
    ViewData["Title"] = $"Request #{Model.Id}";
}

<div class="confirmation mx-auto">
    <div class="text-center mb-4">
        <img src="~/images/success.svg" alt="" width="96" height="96" class="no-print"/>
        <h1 class="h2 mt-3">Thank you! Your request is sent.</h1>
        <p class="text-muted">Keep the request number. We will call you soon.</p>
    </div>

    <div class="card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Request #@Model.Id</h2>
            <span class="badge fs-6 @UiHelper.StatusBadge(Model.Status)">@Model.Status.GetDisplayName()</span>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-4">Date</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-4">Customer</dt>
            <dd class="col-sm-8">@Model.CustomerName, @Model.CustomerPhone</dd>

            <dt class="col-sm-4">Service / problem</dt>
            <dd class="col-sm-8">@Model.ProblemDescription</dd>

            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8">
                @if (Model.TotalCost.HasValue)
                {
                    <span class="price">@Model.TotalCost.Value.ToString("0") UAH</span>
                }
                else
                {
                    <span class="text-muted">will be set after diagnostics</span>
                }
            </dd>
        </dl>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4 no-print">
        <button type="button" class="btn btn-outline-brand" onclick="window.print()">Print</button>
        <a asp-controller="Services" asp-action="Index" class="btn btn-outline-brand">Back to services</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-brand">Home page</a>
    </div>
</div>
