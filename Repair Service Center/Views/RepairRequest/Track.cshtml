@model TrackRequestViewModel
@{
    ViewData["Title"] = Localizer["Track request"];
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1>@Localizer["Track your request"]</h1>
        <p class="text-muted">@Localizer["Enter the request number and the phone number from the request."]</p>

        <form asp-action="Track" method="get" class="card p-3 mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label asp-for="OrderId" class="form-label small"></label>
                    <input asp-for="OrderId" type="number" min="1" class="form-control" required/>
                </div>
                <div class="col-sm-5">
                    <label asp-for="Phone" class="form-label small"></label>
                    <input asp-for="Phone" class="form-control" placeholder="+380..." required/>
                </div>
                <div class="col-sm-3">
                    <button type="submit" class="btn btn-brand w-100">@Localizer["Find"]</button>
                </div>
            </div>
        </form>

        @if (Model.Searched && Model.Order == null)
        {
            <div class="alert alert-warning">
                @Localizer["The request was not found. Please check the number and the phone."]
            </div>
        }

        @if (Model.Order != null)
        {
            <partial name="_OrderCard" model="Model.Order"/>
        }
    </div>
</div>
