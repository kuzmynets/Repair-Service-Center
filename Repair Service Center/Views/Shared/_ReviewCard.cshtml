@model Review
@* One review. Used on the home page and on the reviews page. *@

<div class="card review-card h-100 p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-semibold">@Model.AuthorName</span>
        <span class="stars">@UiHelper.Stars(Model.Rating)</span>
    </div>
    <p class="mb-2 flex-grow-1">@Model.Text</p>
    <div class="small text-muted">@Model.CreatedAt.ToString("dd.MM.yyyy")</div>
</div>
