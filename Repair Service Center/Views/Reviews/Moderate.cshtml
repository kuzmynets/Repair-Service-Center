@model IEnumerable<Review>
@{
    ViewData["Title"] = Localizer["Reviews moderation"];
}

<h1>@Localizer["Reviews moderation"]</h1>
<p class="text-muted">@Localizer["New reviews are not visible on the site until they are approved."]</p>

<table class="table align-middle">
    <thead>
        <tr>
            <th>@Localizer["Date"]</th>
            <th>@Localizer["Author"]</th>
            <th>@Localizer["Rating"]</th>
            <th>@Localizer["Review"]</th>
            <th>@Localizer["Request"]</th>
            <th>@Localizer["Status"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var review in Model)
{
        <tr class="@(review.IsApproved ? "" : "table-warning")">
            <td class="text-nowrap">@review.CreatedAt.ToString("dd.MM.yyyy")</td>
            <td>@review.AuthorName</td>
            <td class="stars text-nowrap">@UiHelper.Stars(review.Rating)</td>
            <td>@review.Text</td>
            <td>
                @if (review.OrderId != null)
                {
                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@review.OrderId">#@review.OrderId</a>
                }
            </td>
            <td>
                @if (review.IsApproved)
                {
                    <span class="badge bg-success">@Localizer["Published"]</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">@Localizer["New"]</span>
                }
            </td>
            <td class="text-end text-nowrap">
                <form asp-action="SetApproved" asp-route-id="@review.Id" method="post" class="d-inline">
                    <input type="hidden" name="approved" value="@(review.IsApproved ? "false" : "true")"/>
                    <button type="submit" class="btn btn-sm @(review.IsApproved ? "btn-outline-secondary" : "btn-success")">
                        @(review.IsApproved ? Localizer["Hide"] : Localizer["Approve"])
                    </button>
                </form>
                <form asp-action="Delete" asp-route-id="@review.Id" method="post" class="d-inline"
                      data-confirm="@Localizer.GetString("Delete this review?")" onsubmit="return confirm(this.dataset.confirm);">
                    <button type="submit" class="btn btn-sm btn-outline-danger">@SharedLocalizer["Delete"]</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
