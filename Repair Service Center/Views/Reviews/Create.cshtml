@model Review
@{
    ViewData["Title"] = Localizer["Write a review"];

    var ratings = new SelectList(new[]
    {
        // Laboratory work 8: GetString returns a plain string for the drop-down list
        new { Value = 5, Text = "\u2605\u2605\u2605\u2605\u2605  " + Localizer.GetString("Excellent") },
        new { Value = 4, Text = "\u2605\u2605\u2605\u2605  " + Localizer.GetString("Good") },
        new { Value = 3, Text = "\u2605\u2605\u2605  " + Localizer.GetString("Normal") },
        new { Value = 2, Text = "\u2605\u2605  " + Localizer.GetString("Bad") },
        new { Value = 1, Text = "\u2605  " + Localizer.GetString("Very bad") }
    }, "Value", "Text", Model.Rating);
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1>@Localizer["Write a review"]</h1>
        <p class="text-muted">@Localizer["Your review will be published after a check by the moderator."]</p>

        <form asp-action="Create" method="post" class="card p-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AuthorName" class="form-label"></label>
                    <input asp-for="AuthorName" class="form-control"/>
                    <span asp-validation-for="AuthorName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Rating" class="form-label"></label>
                    <select asp-for="Rating" asp-items="ratings" class="form-select"></select>
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Text" class="form-label"></label>
                    <textarea asp-for="Text" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Text" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OrderId" class="form-label"></label>
                    <input asp-for="OrderId" class="form-control" placeholder="@Localizer["optional"]"/>
                    <span asp-validation-for="OrderId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-accent">@Localizer["Send review"]</button>
                    <a asp-action="Index" class="btn btn-link">@Localizer["Back to reviews"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
