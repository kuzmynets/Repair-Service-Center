@model IEnumerable<Review>
@{
    ViewData["Title"] = "Reviews";
    var average = (double)(ViewData["Average"] ?? 0d);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Customer reviews</h1>
        @if (Model.Any())
        {
            <div>
                <span class="stars fs-5">@UiHelper.Stars((int)Math.Round(average))</span>
                <span class="text-muted ms-2">@average.ToString("0.0") of 5 &middot; @Model.Count() reviews</span>
            </div>
        }
    </div>
    <a asp-action="Create" class="btn btn-accent">Write a review</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">There are no reviews yet. Be the first!</p>
}

<div class="row g-4">
    @foreach (var review in Model)
    {
        <div class="col-md-6 col-lg-4">
            <partial name="_ReviewCard" model="review"/>
        </div>
    }
</div>
