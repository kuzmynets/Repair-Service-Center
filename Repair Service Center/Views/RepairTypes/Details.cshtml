@model Repair_Service_Center.Models.RepairType

@{
    ViewData["Title"] = Localizer["Repair Type Details"];
}

<h1>@SharedLocalizer["Details"]</h1>

<div>
    <h4>@Localizer["Repair Type"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-secondary">@SharedLocalizer["Edit"]</a>
    <a asp-action="Index" class="btn btn-link">@SharedLocalizer["Back to list"]</a>
</div>
