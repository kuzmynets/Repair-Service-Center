@model ServiceCatalogViewModel
@{
    ViewData["Title"] = "Services & prices";
}

<div class="mb-4">
    <h1>Services &amp; prices</h1>
    <p class="text-muted mb-0">Find a service by name, device, type of repair or price.</p>
</div>

<!-- Search form: method="get", so the search criteria are in the URL and the link can be shared -->
<form asp-action="Index" method="get" class="card p-3 mb-4 search-panel">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label for="searchString" class="form-label small">Search</label>
            <input type="search" id="searchString" name="searchString" value="@Model.SearchString"
                   class="form-control" placeholder="e.g. screen, battery, laptop"/>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="deviceTypeId" class="form-label small">Device</label>
            <select id="deviceTypeId" name="deviceTypeId" class="form-select" asp-items="Model.DeviceTypeList">
                <option value="">All devices</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="repairTypeId" class="form-label small">Repair type</label>
            <select id="repairTypeId" name="repairTypeId" class="form-select" asp-items="Model.RepairTypeList">
                <option value="">All repairs</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="complexityLevelId" class="form-label small">Complexity</label>
            <select id="complexityLevelId" name="complexityLevelId" class="form-select" asp-items="Model.ComplexityLevelList">
                <option value="">Any level</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="sort" class="form-label small">Sort by</label>
            <select id="sort" name="sort" class="form-select" asp-items="Model.SortList"></select>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <label for="minPrice" class="form-label small">Price from, UAH</label>
            <input type="number" id="minPrice" name="minPrice" value="@Model.MinPrice" min="0" step="1" class="form-control"/>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <label for="maxPrice" class="form-label small">Price to, UAH</label>
            <input type="number" id="maxPrice" name="maxPrice" value="@Model.MaxPrice" min="0" step="1" class="form-control"/>
        </div>
        <div class="col-sm-6 col-lg-8 d-flex gap-2">
            <button type="submit" class="btn btn-brand">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<p class="text-muted small">
    Found: <b>@Model.Services.Count</b> @(Model.Services.Count == 1 ? "service" : "services")
    @if (Model.HasFilters)
    {
        <span>&middot; filters are applied</span>
    }
</p>

@if (!Model.Services.Any())
{
    <div class="alert alert-info">
        Nothing was found. Try to change the search criteria,
        or <a asp-controller="RepairRequest" asp-action="Create">describe your problem</a> &mdash; we will help.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var service in Model.Services)
        {
            <div class="col-sm-6 col-lg-4">
                <partial name="_ServiceCard" model="service"/>
            </div>
        }
    </div>
}
