@model ServiceCatalogViewModel
@{
    ViewData["Title"] = Localizer["Services & prices"];
}

<div class="mb-4">
    <h1>@Localizer["Services & prices"]</h1>
    <p class="text-muted mb-0">@Localizer["Find a service by name, device, type of repair or price."]</p>
</div>

<!-- Search form: method="get", so the search criteria are in the URL and the link can be shared -->
<form asp-action="Index" method="get" class="card p-3 mb-4 search-panel">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label for="searchString" class="form-label small">@SharedLocalizer["Search"]</label>
            <input type="search" id="searchString" name="searchString" value="@Model.SearchString"
                   class="form-control" placeholder="@Localizer["e.g. screen, battery, laptop"]"/>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="deviceTypeId" class="form-label small">@Localizer["Device"]</label>
            <select id="deviceTypeId" name="deviceTypeId" class="form-select" asp-items="Model.DeviceTypeList">
                <option value="">@Localizer["All devices"]</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="repairTypeId" class="form-label small">@Localizer["Repair type"]</label>
            <select id="repairTypeId" name="repairTypeId" class="form-select" asp-items="Model.RepairTypeList">
                <option value="">@Localizer["All repairs"]</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="complexityLevelId" class="form-label small">@Localizer["Complexity"]</label>
            <select id="complexityLevelId" name="complexityLevelId" class="form-select" asp-items="Model.ComplexityLevelList">
                <option value="">@Localizer["Any level"]</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="sort" class="form-label small">@Localizer["Sort by"]</label>
            <select id="sort" name="sort" class="form-select" asp-items="Model.SortList"></select>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <label for="minPrice" class="form-label small">@Localizer["Price from, UAH"]</label>
            <input type="number" id="minPrice" name="minPrice" value="@Model.MinPrice" min="0" step="1" class="form-control"/>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <label for="maxPrice" class="form-label small">@Localizer["Price to, UAH"]</label>
            <input type="number" id="maxPrice" name="maxPrice" value="@Model.MaxPrice" min="0" step="1" class="form-control"/>
        </div>
        <div class="col-sm-6 col-lg-8 d-flex gap-2">
            <button type="submit" class="btn btn-brand">@SharedLocalizer["Search"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Reset"]</a>
        </div>
    </div>
</form>

<p class="text-muted small">
    @* "Services found: 5" - this form needs no plural forms of the noun in Ukrainian *@
    @(Localizer["Services found: <b>{0}</b>", Model.Services.Count])
    @if (Model.HasFilters)
    {
        <span>&middot; @Localizer["filters are applied"]</span>
    }
</p>

@if (!Model.Services.Any())
{
    <div class="alert alert-info">
        @(Localizer["Nothing was found. Try to change the search criteria, or <a href='{0}'>describe your problem</a> — we will help.", Url.Action("Create", "RepairRequest")!])
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var service in Model.Services)
        {
            <div class="col-sm-6 col-lg-4">
                <partial name="_ServiceCard" model="service"/>
            </div>
        }
    </div>
}
