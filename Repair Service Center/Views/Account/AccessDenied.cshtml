@{
    ViewData["Title"] = "Access denied";
}

<div class="text-center py-5">
    <div class="display-1 text-muted">403</div>
    <h1 class="h2">Access denied</h1>
    <p class="text-muted">
        You are logged in as <b>@User.Identity?.Name</b>, but your role does not allow this page.
    </p>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-brand">Home page</a>
        <form asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-brand">Log in as another user</button>
        </form>
    </div>
</div>
