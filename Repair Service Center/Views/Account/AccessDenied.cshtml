@{
    ViewData["Title"] = Localizer["Access denied"];
}

<div class="text-center py-5">
    <div class="display-1 text-muted">403</div>
    <h1 class="h2">@Localizer["Access denied"]</h1>
    <p class="text-muted">
        @(Localizer["You are logged in as <b>{0}</b>, but your role does not allow this page.", User.Identity?.Name ?? ""])
    </p>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-brand">@SharedLocalizer["Home page"]</a>
        <form asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-brand">@Localizer["Log in as another user"]</button>
        </form>
    </div>
</div>
